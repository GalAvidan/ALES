    "stale_context_skill": "ALES/skills/reference/verify-context-freshness.skill.md",
    "cost_control_doctrine": "Vault/Knowledge/concepts/kc-cost-control-requires-budgeting-prompt-and-output.md",
    "rtk_instructions": "copilot-instructions.md (workspace root)"
  },

  "token_governance": {
    "policy": "Load only what the current task names. Escalate minimal → task → full only on a confirmed gap.",
    "rtk_required": true,
    "context_profiles_file": "agent-context/intent/context-profiles.md (per studio)",
    "load_order_file": "agent-context/map/load-order.md (per studio)",
    "manifests_enforce_bounds": true,
    "default_profile": "minimal"
  },

  "staleness_governance": {
    "model": "TTL + fingerprint (ALES V2)",
    "ttl_field": "_meta.ttl_days",
    "derived_from_field": "_meta.derived_from",
    "verification_skill": "ALES/skills/reference/verify-context-freshness.skill.md",
    "high_value_targets": [
      "agent-context/map/workflow.md",
      "agent-context/map/folders.md",
      "agent-context/map/skills-index.md",
      "agent-context/map/tasks-index.md",
      "wiki/index.md (ResearchStudio projects)",
      "wiki/synthesis.md (ResearchStudio projects)"
    ]
  },

  "future_hooks": {
    "traces_layer": "Not yet implemented. Planned: agent-context/traces/{task_id}/{run_id}.trace.json (ALES V3)",
    "adaptive_prioritization": "Not yet implemented. Requires trace collection (ALES V3).",
    "runtime_token_accounting": "Not yet implemented. Budgets are declared but not measured (ALES V3)."
